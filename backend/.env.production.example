# ==============================================================================
# BhuSatya Production Environment Configuration (Railway Deployment)
# ==============================================================================

# Application
APP_NAME=BhuSatya
DEMO_MODE=false
TESTING=false
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (Railway automatically injects DATABASE_URL from Railway PostgreSQL)
# Application automatically normalizes postgresql:// to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:password@host:port/railway

# ML Models (Trained checkpoints bundled in backend container)
LAND_LAYOUT_MODEL_PATH=./ml_models/land_layout_detector.pt
LAND_LAYOUT_CONFIDENCE=0.35
DOCUMENT_ELEMENT_MODEL_PATH=./ml_models/table_signature_stamp_detector.pt
DOCUMENT_ELEMENT_CONFIDENCE=0.35
TABLE_DEDUP_IOU_THRESHOLD=0.70
TABLE_TEXT_PROVIDER=paddle_ocr

# Persistent Storage (Railway Volume mounted at /data)
STORAGE_ROOT=/data

# CORS (Set to your Vercel frontend production domain)
FRONTEND_URL=https://bhusatya.vercel.app
FRONTEND_ORIGIN=https://bhusatya.vercel.app
CORS_ORIGINS=https://bhusatya.vercel.app
