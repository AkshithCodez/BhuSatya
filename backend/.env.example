# === Application ===
APP_NAME=BhuSatya
DEMO_MODE=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === PostgreSQL Database ===
# Native PostgreSQL connection with psycopg 3
DATABASE_URL=postgresql+psycopg://bhusatya:password@localhost:5432/bhusatya

# === ML Model 1 - Land Layout Detection ===
LAND_LAYOUT_MODEL_PATH=./ml_models/land_layout_detector.pt
LAND_LAYOUT_CONFIDENCE=0.35

# === ML Model 2 - Table / Signature / Stamp Detection ===
DOCUMENT_ELEMENT_MODEL_PATH=./ml_models/table_signature_stamp_detector.pt
