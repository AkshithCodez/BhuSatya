# === Application ===
APP_NAME=BhuSatya
DEMO_MODE=true
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === PostgreSQL Database ===
# Default local PostgreSQL connection with psycopg 3
DATABASE_URL=postgresql+psycopg://bhusatya:password@localhost:5432/bhusatya
# Development/Test SQLite fallback:
# DATABASE_URL=sqlite:///./bhusatya.db

# === ML Model 1 - Layout Detection ===
LAYOUT_MODEL_PATH=./ml_models/layout_detector.pt
LAYOUT_MODEL_CONFIDENCE=0.35

# === ML Model 2 - Table Text Extraction ===
# Options: mock, manual, ocr, paddle_ocr, custom
TABLE_TEXT_PROVIDER=mock

# === File Storage ===
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads
DOCUMENT_PAGES_DIR=./document_pages
DETECTED_REGIONS_DIR=./detected_regions

# === CORS ===
FRONTEND_URL=http://localhost:5173
