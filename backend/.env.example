# === Fusion ===
TABLE_DEDUP_IOU_THRESHOLD=0.70

# === Table Text Extraction (paddle_ocr | manual) ===
TABLE_TEXT_PROVIDER=paddle_ocr

# === File Storage ===
STORAGE_ROOT=.

# === CORS ===
